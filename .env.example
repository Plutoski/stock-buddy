# Copy this file to .env.local (or add these in Vercel > Project > Settings > Environment Variables)

# Your Base Builder Code, from base.dev > Settings > Builder Codes (looks like bc_xxxxxxxx).
# Every purchase made through Stock Buddy carries this code so it counts as YOUR traction.
NEXT_PUBLIC_BUILDER_CODE=

# Optional: Anthropic API key for the AI chat. Without it, Stock Buddy uses its built-in answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: KyberSwap client id (any short name for your app). Used for purchase quotes.
KYBER_CLIENT_ID=stock-buddy

# Set to 1 to force sample data (useful offline). Leave empty in production.
USE_SAMPLE_DATA=

# Public proof page (/proof). In Vercel: Storage > Create Database > Upstash (Redis) > connect to this project.
# That adds these two automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Your own wallet address(es), comma-separated, so your test purchases are left out of the public numbers.
PROOF_EXCLUDE_WALLETS=
# Optional: a dedicated Base RPC URL (defaults to the public https://mainnet.base.org).
BASE_RPC_URL=
